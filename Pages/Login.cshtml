@page
@model EduCenterManagement.Pages.LoginModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống";
}

<div class="row justify-content-center align-items-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="glass-card p-4 p-md-5 shadow-lg border-0">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                    <i class="bi bi-person-lock fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Đăng Nhập</h3>
                <p class="text-muted small">Hệ thống Quản lý Trung tâm Học tập EduCenter</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @Model.ErrorMessage
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Email đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Email..." required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu..." required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                </button>
            </form>

            <div class="text-center pt-3 mt-3 border-top">
                <span class="text-muted small">Chưa có tài khoản? </span>
                <a class="fw-bold text-success text-decoration-none" asp-page="/Register">
                    Đăng ký ngay <i class="bi bi-person-plus-fill ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

