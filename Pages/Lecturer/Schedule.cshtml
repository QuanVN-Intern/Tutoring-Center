@page
@model EduCenterManagement.Pages.Lecturer.ScheduleModel
@{
    ViewData["Title"] = "Thời khóa biểu Giảng dạy";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-calendar3 text-success me-2"></i>Thời Khóa Biểu Giảng Dạy Cá Nhân</h2>
        <p class="text-muted mb-0">Xem danh sách các lớp học, ca dạy, phòng học và cơ sở được phân công</p>
    </div>
    <span class="badge bg-success text-white fs-6 px-3 py-2">Giảng viên @User.Identity?.Name</span>
</div>

<div class="glass-card p-4">
    <div class="row g-4">
        @if (!Model.AssignedClasses.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-calendar-x display-3"></i>
                <p class="mt-2">Bạn hiện chưa có lớp học nào được phân công!</p>
            </div>
        }
        else
        {
            @foreach (var c in Model.AssignedClasses)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card p-4 h-100 border-start border-4 border-success">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary fs-6">@c.Subject?.SubjectName</span>
                            <status-badge status="@c.Status"></status-badge>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@c.ClassName</h4>
                        <div class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i>@c.Facility?.FacilityName</div>

                        <div class="p-3 bg-light rounded-3 mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-door-open-fill text-primary fs-4 me-2"></i>
                                <div>
                                    <small class="text-muted d-block">Phòng Học</small>
                                    <strong class="fs-5 text-dark">Phòng @c.Room?.RoomNumber</strong>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-alarm-fill text-warning fs-4 me-2"></i>
                                <div>
                                    <small class="text-muted d-block">Ca Học (Timeline)</small>
                                    <strong class="timeline-pill">@c.Shift?.ShiftName (@c.Shift?.StartTime:hh\\:mm–@c.Shift?.EndTime:hh\\:mm)</strong>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-week-fill text-info fs-4 me-2"></i>
                                <div>
                                    <small class="text-muted d-block">Lịch Học Hàng Tuần</small>
                                    <strong class="text-dark">Thứ @c.DaysOfWeek</strong>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a class="btn btn-success btn-sm px-3" asp-page="/Lecturer/Attendance" asp-route-classId="@c.ClassId">
                                <i class="bi bi-check2-square me-1"></i> Điểm Danh Học Viên
                            </a>
                            <a class="btn btn-outline-warning text-dark btn-sm" asp-page="/Lecturer/RoomRequest" asp-route-classId="@c.ClassId">
                                <i class="bi bi-send me-1"></i> Đổi Phòng
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
