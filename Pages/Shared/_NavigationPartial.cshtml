@using System.Security.Claims
@{
    var userRole = User.FindFirstValue(ClaimTypes.Role);
    var userName = User.Identity?.Name ?? "Người dùng";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
}

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand navbar-brand-custom" asp-page="/Index">
            <i class="bi bi-mortarboard-fill me-2"></i>EduCenter Management
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (userRole == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Admin/Dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Admin/Users/Index"><i class="bi bi-people-fill me-1"></i> Quản lý Tài khoản</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Admin/Settings"><i class="bi bi-gear-fill me-1"></i> Cấu hình Hệ thống</a>
                        </li>
                    }
                    else if (userRole == "GrandManager")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/GrandManager/StaffStudents"><i class="bi bi-person-badge me-1"></i> Quản lý Nhân sự & Học viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/GrandManager/Classes"><i class="bi bi-journal-bookmark me-1"></i> Quản lý Lớp & Môn học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/GrandManager/Tuition"><i class="bi bi-cash-stack me-1"></i> Tính toán & Quản lý Học phí</a>
                        </li>
                    }
                    else if (userRole == "FacilityManager")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/FacilityManager/RoomMatrix"><i class="bi bi-grid-3x3-gap-fill me-1"></i> Ma trận Phòng học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/FacilityManager/RoomRequests"><i class="bi bi-arrow-left-right me-1"></i> Yêu cầu Đổi phòng/Ca</a>
                        </li>
                    }
                    else if (userRole == "Lecturer")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Lecturer/Schedule"><i class="bi bi-calendar3 me-1"></i> Lịch dạy & Phòng học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Lecturer/Attendance"><i class="bi bi-check2-square me-1"></i> Điểm danh Học viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Lecturer/RoomRequest"><i class="bi bi-send me-1"></i> Đăng ký Đổi phòng</a>
                        </li>
                    }
                    else if (userRole == "Student")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Student/Schedule"><i class="bi bi-calendar-week me-1"></i> Lịch học & Điểm danh</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-page="/Student/Tuition"><i class="bi bi-wallet2 me-1"></i> Tra cứu Học phí</a>
                        </li>
                    }
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item me-3 text-end text-white">
                        <div class="fw-bold fs-6">@userName</div>
                        <small class="text-light opacity-75">@userEmail</small>
                        <span class="role-badge @userRole?.ToLower() ms-1">@userRole</span>
                    </li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Login" asp-page-handler="Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-light text-primary btn-sm rounded-pill px-4 fw-semibold" asp-page="/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
